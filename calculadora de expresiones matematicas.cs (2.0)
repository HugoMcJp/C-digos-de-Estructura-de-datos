namespace proyecto4_calculadora
{
    // Clase Pila hecha con nodos enlazados (el último en entrar es el primero en salir)
    public class pila
    {
        // Apuntador al nodo que está hasta arriba de la pila
        private nodo tope;

        // Clase interna para representar cada elemento de la pila
        private class nodo
        {
            public char dato;          // El carácter que guardamos (operador o paréntesis)
            public nodo siguiente;     // Enlace al nodo de abajo

            // Constructor del nodo
            public nodo(char dato)
            {
                dato = dato; // Ojo aquí: falta el 'this.dato = dato;' para que no se asigne a sí mismo
            }
        }

        // Checa si la pila no tiene elementos
        public bool vacia()
        {
            return tope == null;
        }

        // Mete un nuevo carácter arriba de la pila (Push)
        public void apilar(char dato)
        {
            nodo nuevo = new nodo(dato); // Creamos el nodo nuevo
            nuevo.siguiente = tope;      // Lo apuntamos al que antes era el tope
            tope = nuevo;                // Ahora el nuevo es el tope
        }

        // Saca el carácter de hasta arriba y lo elimina de la pila (Pop)
        public char desapilar()
        {
            if (vacia())
                return '\0'; // Si está vacía regresamos nulo para que no marque error

            char dato = tope.dato; // Guardamos el dato antes de mover el apuntador
            tope = tope.siguiente; // Bajamos el tope al siguiente nodo

            return dato;
        }

        // Devuelve el carácter de hasta arriba sin sacarlo (Peek)
        public char tope()
        {
            if (vacia())
                return '\0';

            return tope.dato;
        }
    }
}






